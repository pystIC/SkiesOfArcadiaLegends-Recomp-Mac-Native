+// A whole-file patch for a DOL that a game patch extends with new sections (word patches can't add
+// them):
+//   moderngekko-dol-file-patch 1
+//   input-sha256 <hex>     the original DOL it applies to
+//   output-sha256 <hex>    the patched DOL (what the recomp module was built from)
+//   output-size <decimal>
+//   input-size <decimal>          optional, with the two code hashes: the original's size
+//   input-code-sha256 <hex>       the original's code: its header and text sections (DolCodeSha256)
+//   output-code-sha256 <hex>      the patched DOL's code
+//   input-data-sha256 <hex>       optional: the original's data sections (DolDataSha256)
+//   input-fst-sha256 <hex>        optional: the original disc's file table (sys/fst.bin); with the
+//                                 data hash, it tells a romhack from the original (RomhackTag)
+//   data-original <hex file offset> <hex bytes>
+//                                 original data the runs change (a pointer in a table): a romhack
+//                                 that changes it too can't take the patch
+//   known-change <name> <hex file offset> <hex bytes found> <hex original bytes>
+//                                 a romhack's code change the release undoes (it has an option of
+//                                 its own instead); every line of a name has to match, or none
+//                                 of that name is undone
+//   <hex file offset> <hex bytes>   one run per line, ascending
+// It applies to that exact input and checks its output, so the result is byte for byte the DOL the
+// module expects; a DOL that already is the output is left alone. With the code hashes it also
+// takes a DOL whose code is the original's but whose data sections differ (a romhack that changes
+// only data, e.g. the item tables): the runs then touch only the header, code and the new sections
+// past the original's end (tools/mkdolpatch.py checks), so the result has the module's code and
+// the romhack's data.
+constexpr std::string_view FILE_PATCH_HEADER = "moderngekko-dol-file-patch 1";
+
+bool ParseHexBytes(std::string_view text, std::vector<std::uint8_t> *bytes) {
+  if (text.empty() || text.size() % 2 != 0)
+    return false;
+  bytes->clear();
+  for (std::size_t i = 0; i < text.size(); i += 2) {
+    std::uint8_t value = 0;
+    const auto parsed =
+        std::from_chars(text.data() + i, text.data() + i + 2, value, 16);
+    if (parsed.ec != std::errc{} || parsed.ptr != text.data() + i + 2)
+      return false;
+    bytes->push_back(value);
+  }
+  return true;
+}
+
+struct FilePatch {
+  struct Run {
+    std::uint64_t offset;
+    std::vector<std::uint8_t> bytes;
+  };
+  struct DataOriginal {
+    std::uint64_t offset;
+    std::vector<std::uint8_t> bytes;
+  };
+  struct KnownChange {
+    std::string name;
+    std::uint64_t offset;
+    std::vector<std::uint8_t> found;
+    std::vector<std::uint8_t> original;
+  };
+  std::string input_sha, output_sha, input_code_sha, output_code_sha, input_data_sha, input_fst_sha;
+  std::uint64_t output_size = 0, input_size = 0;
+  std::vector<Run> runs;
+  std::vector<DataOriginal> data_originals;
+  std::vector<KnownChange> known_changes;
+};
+
+bool ParseSize(std::string_view value, std::uint64_t *size) {
+  const auto parsed = std::from_chars(value.data(), value.data() + value.size(), *size);
+  return parsed.ec == std::errc{} && parsed.ptr == value.data() + value.size();
+}
+
+bool ParseOffset(std::string_view value, std::uint64_t *offset) {
+  const auto parsed = std::from_chars(value.data(), value.data() + value.size(), *offset, 16);
+  return parsed.ec == std::errc{} && parsed.ptr == value.data() + value.size();
+}
+
+// The rest of the file after its header line
+bool ParseFilePatch(std::istream &input, FilePatch *patch, std::string *error) {
+  std::string line;
+  unsigned line_number = 1;
+  while (std::getline(input, line)) {
+    ++line_number;
+    if (!line.empty() && line.back() == '\r')
+      line.pop_back();
+    if (line.empty())
+      continue;
+    const std::size_t space = line.find(' ');
+    if (space == std::string::npos) {
+      *error = "invalid DOL file patch line " + std::to_string(line_number);
+      return false;
+    }
+    const std::string_view key = std::string_view(line).substr(0, space);
+    const std::string_view value = std::string_view(line).substr(space + 1);
+    bool valid = true;
+    if (key == "input-sha256") {
+      patch->input_sha = value;
+    } else if (key == "output-sha256") {
+      patch->output_sha = value;
+    } else if (key == "input-code-sha256") {
+      patch->input_code_sha = value;
+    } else if (key == "output-code-sha256") {
+      patch->output_code_sha = value;
+    } else if (key == "input-data-sha256") {
+      patch->input_data_sha = value;
+    } else if (key == "input-fst-sha256") {
+      patch->input_fst_sha = value;
+    } else if (key == "output-size") {
+      valid = ParseSize(value, &patch->output_size);
+    } else if (key == "input-size") {
+      valid = ParseSize(value, &patch->input_size);
+    } else if (key == "data-original") {
+      const std::size_t space2 = value.find(' ');
+      FilePatch::DataOriginal original{};
+      valid = space2 != std::string_view::npos &&
+              ParseOffset(value.substr(0, space2), &original.offset) &&
+              ParseHexBytes(value.substr(space2 + 1), &original.bytes);
+      if (valid)
+        patch->data_originals.push_back(std::move(original));
+    } else if (key == "known-change") {
+      // <name> <offset> <found> <original>
+      std::array<std::string_view, 4> fields;
+      std::string_view rest = value;
+      for (std::size_t i = 0; i < fields.size(); ++i) {
+        const std::size_t end = i + 1 < fields.size() ? rest.find(' ') : rest.size();
+        if (end == std::string_view::npos) {
+          valid = false;
+          break;
+        }
+        fields[i] = rest.substr(0, end);
+        rest.remove_prefix(std::min(rest.size(), end + 1));
+      }
+      FilePatch::KnownChange change{};
+      if (valid) {
+        change.name = fields[0];
+        valid = !change.name.empty() && ParseOffset(fields[1], &change.offset) &&
+                ParseHexBytes(fields[2], &change.found) &&
+                ParseHexBytes(fields[3], &change.original) &&
+                change.found.size() == change.original.size();
+      }
+      if (valid)
+        patch->known_changes.push_back(std::move(change));
+    } else {
+      FilePatch::Run run{};
+      valid = ParseOffset(key, &run.offset) && ParseHexBytes(value, &run.bytes);
+      if (valid)
+        patch->runs.push_back(std::move(run));
+    }
+    if (!valid) {
+      *error = "invalid DOL file patch line " + std::to_string(line_number);
+      return false;
+    }
+  }
+  const bool code = !patch->input_code_sha.empty() || !patch->output_code_sha.empty() ||
+                    patch->input_size != 0;
+  if (patch->input_sha.size() != 64 || patch->output_sha.size() != 64 ||
+      patch->output_size == 0 || patch->output_size > (64u << 20) || patch->runs.empty() ||
+      (code && (patch->input_code_sha.size() != 64 || patch->output_code_sha.size() != 64 ||
+                patch->input_size == 0 || patch->input_size > patch->output_size))) {
+    *error = "incomplete DOL file patch";
+    return false;
+  }
+  // Every run in order and inside the output, compared without adding to an untrusted offset.
+  std::uint64_t previous_end = 0;
+  for (const FilePatch::Run &run : patch->runs) {
+    if (run.offset < previous_end || run.offset > patch->output_size ||
+        run.bytes.size() > patch->output_size - run.offset) {
+      *error = "invalid DOL file patch run at " + std::to_string(run.offset);
+      return false;
+    }
+    previous_end = run.offset + run.bytes.size();
+  }
+  for (const FilePatch::DataOriginal &original : patch->data_originals) {
+    if (!code || original.offset > patch->input_size ||
+        original.bytes.size() > patch->input_size - original.offset) {
+      *error = "invalid DOL file patch data-original line";
+      return false;
+    }
+  }
+  for (const FilePatch::KnownChange &change : patch->known_changes) {
+    if (!code || change.offset > patch->input_size ||
+        change.found.size() > patch->input_size - change.offset) {
+      *error = "invalid DOL file patch known change " + change.name;
+      return false;
+    }
+  }
+  return true;
+}
+
+bool LoadFilePatch(const fs::path &path, FilePatch *patch, std::string *error) {
+  std::ifstream input(path);
+  std::string header;
+  if (!input || !std::getline(input, header)) {
+    *error = "can't open DOL patch " + path.string();
+    return false;
+  }
+  if (!header.empty() && header.back() == '\r')
+    header.pop_back();
+  if (header != FILE_PATCH_HEADER) {
+    *error = path.string() + " isn't a whole-file DOL patch";
+    return false;
+  }
+  return ParseFilePatch(input, patch, error);
+}
+
+bool BytesAt(const std::vector<std::uint8_t> &bytes, std::uint64_t offset,
+             const std::vector<std::uint8_t> &expected) {
+  return offset <= bytes.size() && expected.size() <= bytes.size() - offset &&
+         std::equal(expected.begin(), expected.end(),
+                    bytes.begin() + static_cast<std::ptrdiff_t>(offset));
+}
+
+// A patched DOL holds every run (the code hash covers the rest of what the module depends on)
+bool RunsPresent(const FilePatch &patch, const std::vector<std::uint8_t> &bytes) {
+  return bytes.size() == patch.output_size &&
+         std::ranges::all_of(patch.runs, [&](const FilePatch::Run &run) {
+           return BytesAt(bytes, run.offset, run.bytes);
+         });
+}
+
+// Undoes the known changes whose bytes are all there, by name; returns the names undone.
+std::vector<std::string> UndoKnownChanges(const FilePatch &patch,
+                                          std::vector<std::uint8_t> *bytes) {
+  std::vector<std::string> names;
+  for (const FilePatch::KnownChange &first : patch.known_changes) {
+    if (std::ranges::find(names, first.name) != names.end())
+      continue;
+    bool all = true;
+    for (const FilePatch::KnownChange &change : patch.known_changes) {
+      if (change.name == first.name && !BytesAt(*bytes, change.offset, change.found)) {
+        all = false;
+        break;
+      }
+    }
+    if (!all)
+      continue;
+    for (const FilePatch::KnownChange &change : patch.known_changes) {
+      if (change.name == first.name)
+        std::ranges::copy(change.original,
+                          bytes->begin() + static_cast<std::ptrdiff_t>(change.offset));
+    }
+    names.push_back(first.name);
+  }
+  return names;
+}
+
+enum class PatchResult { Patched, AlreadyPatched, Failed };
+
+// Patches a DOL's bytes in memory into the build the patch makes (or the same build with a
+// romhack's data). notes: what the DOL was.
+PatchResult PatchDolBytes(const FilePatch &patch, std::vector<std::uint8_t> *bytes,
+                          DolPatchNotes *notes, std::string *error) {
+  const std::string actual = moderngekko::Sha256(*bytes);
+  if (actual == patch.output_sha)
+    return PatchResult::AlreadyPatched;
+  if (actual != patch.input_sha) {
+    if (patch.input_code_sha.empty()) {
+      *error = "main.dol isn't the one this release patches (SHA-256 " + actual + ", expected " +
+               patch.input_sha + ")";
+      return PatchResult::Failed;
+    }
+    // Not the original: the same code with other data (a romhack), possibly with known code
+    // changes this release undoes, or already patched by an earlier run of this
+    std::vector<std::uint8_t> undone = *bytes;
+    const std::vector<std::string> names = UndoKnownChanges(patch, &undone);
+    const std::optional<std::string> code = DolCodeSha256(undone);
+    if (code && *code == patch.output_code_sha && RunsPresent(patch, undone)) {
+      notes->modified_data = true;
+      return PatchResult::AlreadyPatched;
+    }
+    if (!code || *code != patch.input_code_sha) {
+      notes->modified_code = true;
+      *error = "main.dol's game code is modified (a romhack that changes the game's code, or "
+               "another version of the game); this release takes romhacks that change only the "
+               "game's data";
+      return PatchResult::Failed;
+    }
+    for (const FilePatch::DataOriginal &original : patch.data_originals) {
+      if (!BytesAt(undone, original.offset, original.bytes)) {
+        std::array<char, 96> message{};
+        std::snprintf(message.data(), message.size(),
+                      "the romhack changes game data this release patches too (main.dol offset "
+                      "0x%llx)",
+                      static_cast<unsigned long long>(original.offset));
+        *error = message.data();
+        return PatchResult::Failed;
+      }
+    }
+    notes->modified_data = true;
+    notes->undone = names;
+    *bytes = std::move(undone);
+    // The new sections start past the original's end: whatever a romhack left there goes
+    bytes->resize(static_cast<std::size_t>(patch.input_size));
+  }
+  bytes->resize(static_cast<std::size_t>(patch.output_size), 0);
+  for (const FilePatch::Run &run : patch.runs)
+    std::ranges::copy(run.bytes, bytes->begin() + static_cast<std::ptrdiff_t>(run.offset));
+  if (notes->modified_data ? DolCodeSha256(*bytes) != patch.output_code_sha
+                           : moderngekko::Sha256(*bytes) != patch.output_sha) {
+    *error = "patched main.dol doesn't match the release (patch file damaged?)";
+    return PatchResult::Failed;
+  }
+  return PatchResult::Patched;
+}
+
+bool ApplyFilePatch(const fs::path &dol_path, std::istream &input, bool *changed,
+                    std::string *error, DolPatchNotes *notes) {
+  FilePatch patch;
+  if (!ParseFilePatch(input, &patch, error))
+    return false;
+  std::vector<std::uint8_t> bytes;
+  if (!ReadFile(dol_path, &bytes, error))
+    return false;
+  switch (PatchDolBytes(patch, &bytes, notes, error)) {
+  case PatchResult::AlreadyPatched:
+    return true;
+  case PatchResult::Failed:
+    return false;
+  case PatchResult::Patched:
+    break;
+  }
+  *changed = true;
+  return ReplaceFile(dol_path, bytes, error);
+}
 } // namespace
 
+std::optional<std::string> DolCodeSha256(const std::vector<std::uint8_t> &bytes) {
+  constexpr std::size_t HEADER_SIZE = 0x100;
+  if (bytes.size() < HEADER_SIZE)
+    return std::nullopt;
+  std::vector<std::uint8_t> code(bytes.begin(), bytes.begin() + HEADER_SIZE);
+  for (unsigned index = 0; index < 7; ++index) {
+    const std::uint32_t offset = ReadBE32(bytes.data() + index * 4);
+    const std::uint32_t size = ReadBE32(bytes.data() + 0x90 + index * 4);
+    if (size == 0)
+      continue;
+    if (offset < HEADER_SIZE || offset > bytes.size() || size > bytes.size() - offset)
+      return std::nullopt;
+    code.insert(code.end(), bytes.begin() + offset, bytes.begin() + offset + size);
+  }
+  return moderngekko::Sha256(std::move(code));
+}
+
+std::optional<std::string> DolDataSha256(const std::vector<std::uint8_t> &bytes,
+                                         std::uint64_t below) {
+  if (bytes.size() < 0x100)
+    return std::nullopt;
+  std::vector<std::uint8_t> data;
+  for (unsigned index = 7; index < 18; ++index) {
+    const std::uint32_t offset = ReadBE32(bytes.data() + index * 4);
+    const std::uint32_t size = ReadBE32(bytes.data() + 0x90 + index * 4);
+    if (size == 0)
+      continue;
+    if (offset > bytes.size() || size > bytes.size() - offset)
+      return std::nullopt;
+    if (std::uint64_t{offset} + size > below)
+      continue;
+    data.insert(data.end(), bytes.begin() + offset, bytes.begin() + offset + size);
+  }
+  return moderngekko::Sha256(std::move(data));
+}
+
+std::string RomhackTag(const fs::path &game_root, const fs::path &patch_path) {
+  FilePatch patch;
+  std::string error;
+  std::vector<std::uint8_t> dol;
+  if (patch_path.empty() || !LoadFilePatch(patch_path, &patch, &error) ||
+      patch.input_data_sha.empty() || !ReadFile(game_root / "sys" / "main.dol", &dol, &error))
+    return {};
+  // The patch's own data back to the original's, so every release of the patch gives the same tag
+  for (const FilePatch::DataOriginal &original : patch.data_originals) {
+    if (original.offset <= dol.size() && original.bytes.size() <= dol.size() - original.offset)
+      std::ranges::copy(original.bytes, dol.begin() + static_cast<std::ptrdiff_t>(original.offset));
+  }
+  // The original's sections only: the patch adds one of its own past the original's end
+  const std::optional<std::string> data =
+      DolDataSha256(dol, patch.input_size ? patch.input_size : UINT64_MAX);
+  if (!data)
+    return {};
+  std::string fst;
+  if (std::vector<std::uint8_t> table; ReadFile(game_root / "sys" / "fst.bin", &table, &error))
+    fst = moderngekko::Sha256(std::move(table));
+  if (*data == patch.input_data_sha && (patch.input_fst_sha.empty() || fst == patch.input_fst_sha))
+    return {};
+  return moderngekko::Sha256(*data + fst).substr(0, 8);
+}
+
+fs::path StateDirectory(const fs::path &user_directory, std::string_view tag,
+                        std::string_view disc_folder) {
+  if (!tag.empty())
+    return user_directory / "StateSaves" / ("romhack-" + std::string(tag));
+  return disc_folder.empty() ? user_directory / "StateSaves"
+                             : user_directory / "StateSaves" / std::string(disc_folder);
+}
+
+int MoveDiscStates(const fs::path &user_directory, const fs::path &folder,
+                   std::string_view disc_id) {
+  const fs::path root = user_directory / "StateSaves";
+  std::error_code ec;
+  if (disc_id.empty() || fs::equivalent(root, folder, ec))
+    return 0;
+  int moved = 0;
+  for (const fs::directory_entry &entry : fs::directory_iterator(root, ec)) {
+    const std::string name = entry.path().filename().string();
+    if (!entry.is_regular_file(ec) || !name.ends_with(".sav") ||
+        !(name.starts_with("state-skies-") || name.starts_with("recovery-skies-")))
+      continue;
+    // Dolphin's state header starts with the game ID (StateFile.h LegacyStateHeader)
+    std::array<char, 6> id{};
+    {
+      std::ifstream file(entry.path(), std::ios::binary);
+      if (!file.read(id.data(), id.size()) ||
+          std::string_view(id.data(), id.size()) != disc_id)
+        continue;
+    }
+    const fs::path target = folder / entry.path().filename();
+    if (fs::exists(target, ec))
+      continue;
+    fs::create_directories(folder, ec);
+    fs::rename(entry.path(), target, ec);
+    if (!ec)
+      ++moved;
+  }
+  return moved;
+}
+
+bool DolMatchesPin(const fs::path &dol_path, const fs::path &patch_path,
+                   std::string_view pinned_sha256, bool *modified_data) {
+  if (modified_data)
+    *modified_data = false;
+  std::vector<std::uint8_t> bytes;
+  std::string error;
+  if (!ReadFile(dol_path, &bytes, &error))
+    return false;
+  if (moderngekko::Sha256(bytes) == pinned_sha256)
+    return true;
+  // The patch has to be the one that makes the pinned build, for its code hash to stand for it
+  FilePatch patch;
+  if (patch_path.empty() || !LoadFilePatch(patch_path, &patch, &error) ||
+      patch.output_sha != pinned_sha256 || patch.output_code_sha.empty() ||
+      DolCodeSha256(bytes) != patch.output_code_sha || !RunsPresent(patch, bytes))
+    return false;
+  if (modified_data)
+    *modified_data = true;
+  return true;
+}
+
+bool PatchDolInMemory(std::vector<std::uint8_t> *bytes, const fs::path &patch_path,
+                      std::string *error, DolPatchNotes *notes) {
+  DolPatchNotes ignored;
+  FilePatch patch;
+  return LoadFilePatch(patch_path, &patch, error) &&
+         PatchDolBytes(patch, bytes, notes ? notes : &ignored, error) != PatchResult::Failed;
+}
