+// The branded launcher's background picture, launcher-background.png beside the executable
+// (release/ in the recomp repo; Skies: art by I_LIKE_SONIC, credited in README.md / CREDITS.md). nullptr without one: the launcher keeps its plain look.
+SDL_Texture* LoadLauncherBackground(SDL_Renderer* renderer, const fs::path& path)
+{
+#ifdef __APPLE__
+  // Not Common::LoadPNG: libc++ tags UniqueBuffer's deleter with the exceptions setting, and Dolphin's
+  // libcommon is built with -fno-exceptions, so the launcher's call doesn't link. SDL decodes it.
+  SDL_Surface* surface = SDL_LoadPNG(path.string().c_str());
+  if (!surface)
+    return nullptr;
+  SDL_Texture* texture = SDL_CreateTextureFromSurface(renderer, surface);
+  SDL_DestroySurface(surface);
+  if (texture)
+    SDL_SetTextureScaleMode(texture, SDL_SCALEMODE_LINEAR);
+  return texture;
+#else
+  std::ifstream file(path, std::ios::binary);
+  if (!file)
+    return nullptr;
+  const std::vector<u8> png{std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+  Common::UniqueBuffer<u8> pixels;
+  u32 width = 0;
+  u32 height = 0;
+  if (!Common::LoadPNG(png, &pixels, &width, &height))
+    return nullptr;
+  SDL_Texture* texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGBA32,
+                                           SDL_TEXTUREACCESS_STATIC, static_cast<int>(width),
+                                           static_cast<int>(height));
+  if (!texture)
+    return nullptr;
+  SDL_UpdateTexture(texture, nullptr, pixels.data(), static_cast<int>(width * 4));
+  SDL_SetTextureScaleMode(texture, SDL_SCALEMODE_LINEAR);
+  return texture;
+#endif
+}
